# Include the README and SECURITY documents
include *.rst

# Include the license file
include LICENSE

# Include examples files for testing
include examples/example1.wav
include examples/example2.wav
include examples/plot_classifier_performance.py
include scripts/smoke_install.py
include scripts/check_notebooks.py

# Support container builds from source archives as well as Git checkouts
include Dockerfile
include .dockerignore
recursive-include docs *.rst *.py *.css
recursive-include examples/notebooks *.ipynb *.py
recursive-include .devcontainer *.json *.sh
prune docs/_build
prune docs/build
prune examples/notebooks/.ipynb_checkpoints

# Include the classifier model in source distributions
recursive-include batbot/classifier/models/onnx *.onnx
